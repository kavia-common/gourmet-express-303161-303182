# Gourmet Express Frontend environment variables (Create React App)
#
# Notes:
# - CRA only exposes vars prefixed with REACT_APP_.
# - This frontend defaults to http://localhost:3001 for REST and ws://localhost:3001 for WS if nothing is set.

# Preferred REST base URL (no trailing slash), e.g. http://localhost:3001
REACT_APP_API_BASE=http://localhost:3001

# Alternative REST base URL key (supported as fallback)
REACT_APP_BACKEND_URL=http://localhost:3001

# Preferred WebSocket URL.
# You may set either the full endpoint or just the base host:
#   ws://localhost:3001/tracking/stream
#   ws://localhost:3001
REACT_APP_WS_URL=ws://localhost:3001/tracking/stream

# Optional: where the frontend is hosted (useful for redirects in some auth providers; not required for JWT auth)
REACT_APP_FRONTEND_URL=http://localhost:3000
